# Copy to ~/elements/.env on the host (not in git) and fill in. One container
# serves every active region of the database (geo.regions, active = true).
# Database: as role elements_app (reads geo, writes game and analytics,
# no schema changes). elements_owner is only for Flyway and imports.
# Unquoted: Docker keeps quotes as part of the value.
ELEMENTS_DB=postgresql://user:password@host/elements?sslmode=require
# Dashboard reads as elements_read (optional; default ELEMENTS_DB):
# ELEMENTS_DB_READ=postgresql://elements_read:password@host/elements?sslmode=require
# Default region: requests without ?region= (older app versions, tools).
ELEMENTS_REGION=region-konstanz
ELEMENTS_OPS_TOKEN=change-me
# Logins for dashboard and editor through the proxy (docs/deploy.md, Logins),
# instead of or besides tokens. Only behind a proxy that strips these headers:
#   ELEMENTS_AUTH_USER_HEADER=Remote-User
#   ELEMENTS_AUTH_GROUPS_HEADER=Remote-Groups
#   ELEMENTS_AUTH_GROUP_PREFIX=elements-
#   ELEMENTS_AUTH_LOGOUT_URL=https://auth.example.org/logout
# Public base URL of this instance (presence-code links, globe) and where its
# source is published (AGPL: the app links to it next to the version).
ELEMENTS_PUBLIC_URL=https://example.org
ELEMENTS_SOURCE_URL=https://github.com/glutflut/glutflut
# Secret for the noise on published counts (e.g. `openssl rand -hex 32`); keep it
# stable, a new key changes all published numbers.
ELEMENTS_NOISE_KEY=change-me

# Regions load when the first player opens them and unload after
# ELEMENTS_IDLE_MIN minutes without anyone (default 180, so leftovers below k
# can still pool with the next player; unloading drops them). Kept loaded always:
#   ELEMENTS_PRELOAD=region-konstanz,region-hamburg
# Most regions loaded at once (default 12; the least recently used idle one goes):
#   ELEMENTS_MAX_REGIONS=12
# Shards (one per continent): this container runs the regions of its shard
# (geo.regions.shard, default eu); the others are linked by URL.
#   ELEMENTS_SHARD=eu
#   ELEMENTS_SHARDS=sa=https://sa.example.org,na=https://na.example.org
# (the other shards, `name=url` separated by commas; listing this one too does no harm)
# With more than one shard all of them need the same secret (passports and
# calls between shards, see server/src/shards.rs), e.g. `openssl rand -hex 32`:
#   ELEMENTS_SHARD_KEY=
# Another cell of the shard (docs/deploy.md, Cells): a copy of this one with
# its own cell and default region (one of its own), run on another port.
#   ELEMENTS_CELL=b
#   ELEMENTS_REGION=region-example
# Rules per region: geo.regions.rules names a file in /srv/rules (without
# .toml); otherwise ELEMENTS_RULES (image default default.toml, see deploy/Dockerfile).
# Region settings (hotspot area, demo day label, city name, language, time
# zone) live in geo.regions (docs/configuration.md).

# Test instance: a test database, tap-to-move allowed (switches off the
# position check), its own ops token.
#   ELEMENTS_DB=<test database>
#   ELEMENTS_ALLOW_SIM=1
#   ELEMENTS_LIMITS=0          # only while running bots against it
# Own thresholds for the cheat checks (keys in crates/server/src/cheat.rs):
# ELEMENTS_CHEAT=max_speed_ms=8; lock_s=60
